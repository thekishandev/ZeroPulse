# ZeroPulse — environment variables
# Copy to .env.local for local development.

# ── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# On Zerops this is injected automatically via ${db_connectionString}.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Optional ────────────────────────────────────────────────────────────────

# Set to "false" to enable live Zerops API calls.
# When true (default) ZeroPulse serves representative demo data instead.
MOCK_MODE=true

# When set, the AI advisor uses GPT-4o-mini for a richer analysis pass.
# Falls back to the built-in rule-based engine when absent.
OPENAI_API_KEY=sk-...

# Zerops REST API base URL — no need to change this.
ZEROPS_API_BASE=https://api.app-prg1.zerops.io
